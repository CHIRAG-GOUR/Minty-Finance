rules_version = '2';

// Skillizee shared Firebase project (olympiad-dashboard).
//
// This project hosts more than one app, so these rules are written to be
// additive: Minty owns `users/{uid}.apps.minty` and nothing else. Another app
// added later gets its own key under `apps` and its own clause here, without
// either being able to overwrite the other.
//
// The only authorization boundary is the authenticated Firebase UID. There are
// no roles, no custom claims and no admin bypass — removing RBAC from the
// client would mean nothing if the rules still trusted a "role" field.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Identity is shared by every app in this project.
    function identityKeys() {
      return ['uid', 'phoneNumber', 'displayName', 'email',
              'createdAt', 'updatedAt', 'lastLoginAt'];
    }

    // A write may touch the shared identity fields plus the per-app bag.
    function touchesOnlyAllowedKeys() {
      return request.resource.data.keys().hasOnly(identityKeys().concat(['apps']));
    }

    function displayNameIsSane() {
      return !('displayName' in request.resource.data)
             || (request.resource.data.displayName is string
                 && request.resource.data.displayName.size() > 0
                 && request.resource.data.displayName.size() <= 40);
    }

    function emailIsSane() {
      return !('email' in request.resource.data)
             || (request.resource.data.email is string
                 && request.resource.data.email.size() <= 80);
    }

    // A client must never be able to move a document to a different owner.
    function uidFieldMatches(uid) {
      return !('uid' in request.resource.data) || request.resource.data.uid == uid;
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && touchesOnlyAllowedKeys()
                            && displayNameIsSane()
                            && emailIsSane()
                            && uidFieldMatches(uid);
      // Profiles are retained on sign-out so a returning user keeps their
      // identity and progress. Deletion is an out-of-band operation.
      allow delete: if false;
    }

    // Anything not matched above is closed. Add a sibling match block per app
    // rather than loosening this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
